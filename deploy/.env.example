# FlyGit — environment template.
# Copy to `deploy/.env` and fill in the secrets. Compose reads this file.

# ─────────────────────── HTTP / public URLs ───────────────────────
# Host port for the web entrypoint (nginx → api + SPA).
HTTP_PORT=8080
# Host port for Git over SSH.
SSH_PORT=2222
# Public URLs used in clone links and email templates.
APP_URL=http://localhost:8080
API_URL=http://localhost:8080

# ─────────────────────────── PostgreSQL ───────────────────────────
POSTGRES_DB=flygit
POSTGRES_USER=flygit
# REQUIRED — postgres refuses to start without a password.
POSTGRES_PASSWORD=change-me

# ───────────────────────────── Secrets ────────────────────────────
# REQUIRED — JWT signing keys (>=16 chars). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
# REQUIRED — shared secret for git pre/post-receive hooks calling the API.
FLYGIT_HOOK_SECRET=change-me-hook-secret-32-chars-min

# ────────────────────────── Registration ──────────────────────────
# open | invite
REGISTRATION_MODE=open
ALLOW_REGISTRATION=true
CONFIRM_EMAIL_REQUIRED=true

# ────────────────────────────── Mail ──────────────────────────────
# log | smtp | none  (log prints emails to stdout — handy for development)
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FlyGit <noreply@flygit.local>

# ────────────────────────────── Git SSH ───────────────────────────
SSH_ENABLED=true

# ─────────────────────────────── Misc ─────────────────────────────
LOG_LEVEL=info
TRUST_PROXY=true
